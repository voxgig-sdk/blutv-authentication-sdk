# Entity: password_recovery

main: kit: entity: password_recovery: {

  alias: field: {}

  fields: [
    {
      format: "email"
      name: "email"
      req: true
      short: "Email address for password recovery"
      type: "`$STRING`"
    }
    {
      name: "message"
      req: false
      short: "Success message"
      type: "`$STRING`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
  ]

  name: "password_recovery"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/auth/password-recovery"
          segments: [
            {
              lit: "auth"
            }
            {
              lit: "password-recovery"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
