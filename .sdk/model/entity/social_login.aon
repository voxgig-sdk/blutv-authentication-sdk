# Entity: social_login

main: kit: entity: social_login: {

  alias: field: {}

  fields: [
    {
      name: "accessToken"
      req: true
      short: "OAuth access token from the social provider"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "createdAt"
      req: false
      short: "Account creation timestamp"
      type: "`$STRING`"
    }
    {
      format: "email"
      name: "email"
      req: false
      short: "User's email address"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique user identifier"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "User's full name"
      type: "`$STRING`"
    }
    {
      name: "phone"
      req: false
      short: "User's phone number"
      type: "`$STRING`"
    }
    {
      name: "provider"
      req: true
      short: "Social media provider"
      type: "`$STRING`"
    }
    {
      name: "subscriptionStatus"
      req: false
      short: "User's subscription status"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "social_login"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /auth/social-login"
            json: "{\"operationId\":\"socialLogin\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"facebookLogin\":{\"summary\":\"Login with Facebook\",\"value\":{\"accessToken\":\"EAABwzLixnjYBAO...\",\"provider\":\"facebook\"}},\"googleLogin\":{\"summary\":\"Login with Google\",\"value\":{\"accessToken\":\"ya29.a0AfH6SMBx...\",\"provider\":\"google\"}}},\"schema\":{\"properties\":{\"accessToken\":{\"description\":\"OAuth access token from the social provider\",\"example\":\"EAABwzLixnjYBAO...\",\"type\":\"string\"},\"provider\":{\"description\":\"Social media provider\",\"enum\":[\"facebook\",\"google\"],\"example\":\"facebook\",\"type\":\"string\"}},\"required\":[\"provider\",\"accessToken\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"expiresIn\":{\"description\":\"Token expiration time in seconds\",\"example\":3600,\"type\":\"integer\"},\"refreshToken\":{\"description\":\"Refresh token for obtaining new access tokens\",\"example\":\"rt_8f9a7b6c5d4e3f2a1b0c9d8e7f6a5b4c\",\"type\":\"string\"},\"success\":{\"example\":true,\"type\":\"boolean\"},\"token\":{\"description\":\"JWT authentication token\",\"example\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\"type\":\"string\"},\"user\":{\"properties\":{\"createdAt\":{\"description\":\"Account creation timestamp\",\"example\":\"2023-01-15T10:30:00Z\",\"format\":\"date-time\",\"type\":\"string\"},\"email\":{\"description\":\"User's email address\",\"example\":\"user@example.com\",\"format\":\"email\",\"type\":\"string\"},\"id\":{\"description\":\"Unique user identifier\",\"example\":\"usr_123456789\",\"type\":\"string\"},\"name\":{\"description\":\"User's full name\",\"example\":\"John Doe\",\"type\":\"string\"},\"phone\":{\"description\":\"User's phone number\",\"example\":\"+905551234567\",\"type\":\"string\"},\"subscriptionStatus\":{\"description\":\"User's subscription status\",\"enum\":[\"active\",\"inactive\",\"trial\"],\"example\":\"active\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Successfully authenticated via social provider\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"example\":\"INVALID_CREDENTIALS\",\"type\":\"string\"},\"details\":{\"items\":{\"properties\":{\"field\":{\"example\":\"email\",\"type\":\"string\"},\"message\":{\"example\":\"Email is required\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"message\":{\"description\":\"Human-readable error message\",\"example\":\"Invalid email or password\",\"type\":\"string\"}},\"type\":\"object\"},\"success\":{\"example\":false,\"type\":\"boolean\"}},\"type\":\"object\"}}},\"description\":\"Bad request - invalid provider or token\"},\"401\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"example\":\"INVALID_CREDENTIALS\",\"type\":\"string\"},\"details\":{\"items\":{\"properties\":{\"field\":{\"example\":\"email\",\"type\":\"string\"},\"message\":{\"example\":\"Email is required\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"message\":{\"description\":\"Human-readable error message\",\"example\":\"Invalid email or password\",\"type\":\"string\"}},\"type\":\"object\"},\"success\":{\"example\":false,\"type\":\"boolean\"}},\"type\":\"object\"}}},\"description\":\"Invalid or expired social token\"}},\"securitySchemes\":{\"bearerAuth\":{\"bearerFormat\":\"JWT\",\"description\":\"JWT token obtained from login or social login endpoints\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/auth/social-login"
          segments: [
            {
              lit: "auth"
            }
            {
              lit: "social-login"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
      ]
    }
  }



}
