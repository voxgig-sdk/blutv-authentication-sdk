# Entity: social_login

main: kit: entity: social_login: {

  alias: field: {}

  fields: [
    {
      name: "accessToken"
      req: true
      short: "OAuth access token from the social provider"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "createdAt"
      req: false
      short: "Account creation timestamp"
      type: "`$STRING`"
    }
    {
      format: "email"
      name: "email"
      req: false
      short: "User's email address"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique user identifier"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "User's full name"
      type: "`$STRING`"
    }
    {
      name: "phone"
      req: false
      short: "User's phone number"
      type: "`$STRING`"
    }
    {
      name: "provider"
      req: true
      short: "Social media provider"
      type: "`$STRING`"
    }
    {
      name: "subscriptionStatus"
      req: false
      short: "User's subscription status"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "social_login"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/auth/social-login"
          segments: [
            {
              lit: "auth"
            }
            {
              lit: "social-login"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
      ]
    }
  }



}
