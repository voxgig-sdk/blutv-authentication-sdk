# Entity: login

main: kit: entity: login: {

  alias: field: {}

  fields: [
    {
      format: "date-time"
      name: "createdAt"
      req: false
      short: "Account creation timestamp"
      type: "`$STRING`"
    }
    {
      format: "email"
      name: "email"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "User's email address"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique user identifier"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "User's full name"
      type: "`$STRING`"
    }
    {
      format: "password"
      name: "password"
      req: true
      short: "User's password"
      type: "`$STRING`"
    }
    {
      name: "phone"
      req: false
      short: "User's phone number"
      type: "`$STRING`"
    }
    {
