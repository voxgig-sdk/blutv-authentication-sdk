# Entity: login

main: kit: entity: login: {

  alias: field: {}

  fields: [
    {
      name: "createdAt"
      req: false
      type: "`$STRING`"
    }
    {
      name: "email"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "password"
      req: true
      type: "`$STRING`"
    }
    {
      name: "phone"
      req: false
      type: "`$STRING`"
    }
    {
      name: "rememberMe"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "subscriptionStatus"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "login"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/auth/login"
          parts: [
            "auth"
            "login"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
      ]
    }
  }



}
