# Entity: login

main: kit: entity: login: {

  alias: field: {}

  fields: {
    createdAt: {
      fo: "date-time"
      h: "Created At"
      n: "createdAt"
      r: false
      sh: "Account creation timestamp"
      t: "`$STRING`"
    }
    email: {
      fo: "email"
      h: "Email"
      n: "email"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "User's email address"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique user identifier"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "User's full name"
      t: "`$STRING`"
    }
    password: {
      fo: "password"
      h: "Password"
      n: "password"
      r: true
      sh: "User's password"
      t: "`$STRING`"
    }
    phone: {
      h: "Phone"
      n: "phone"
      r: false
      sh: "User's phone number"
      t: "`$STRING`"
    }
    rememberMe: {
      h: "Remember Me"
      n: "rememberMe"
      r: false
      sh: "Keep user logged in"
      t: "`$BOOLEAN`"
    }
    subscriptionStatus: {
      h: "Subscription Status"
      n: "subscriptionStatus"
      r: false
      sh: "User's subscription status"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "login"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /auth/login"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/auth/login"
          s: [
            {
              lit: "auth"
            }
            {
              lit: "login"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
      ]
    }
  }



}
