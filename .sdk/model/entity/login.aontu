# Entity: login

main: kit: entity: login: {

  alias: field: {}

  fields: {
    email: {
      fo: "email"
      h: "Email"
      n: "email"
      r: true
      sh: "User's email address or username"
      t: "`$STRING`"
    }
    expiresIn: {
      h: "Expires In"
      n: "expiresIn"
      r: false
      sh: "Token expiration time in seconds"
      t: "`$INTEGER`"
    }
    password: {
      fo: "password"
      h: "Password"
      n: "password"
      r: true
      sh: "User's password"
      t: "`$STRING`"
    }
    refreshToken: {
      h: "Refresh Token"
      n: "refreshToken"
      r: false
      sh: "Refresh token for obtaining new access tokens"
      t: "`$STRING`"
    }
    rememberMe: {
      h: "Remember Me"
      n: "rememberMe"
      r: false
      sh: "Keep user logged in"
      t: "`$BOOLEAN`"
    }
    success: {
      h: "Success"
      n: "success"
      r: false
      t: "`$BOOLEAN`"
    }
    token: {
      h: "Token"
      n: "token"
      r: false
      sh: "JWT authentication token"
      t: "`$STRING`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      t: "`$OBJECT`"
    }
  }

  name: "login"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /auth/login"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/auth/login"
          s: [
            {
              lit: "auth"
            }
            {
              lit: "login"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
