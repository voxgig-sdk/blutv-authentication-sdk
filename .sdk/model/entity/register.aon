# Entity: register

main: kit: entity: register: {

  alias: field: {}

  fields: [
    {
      format: "email"
      name: "email"
      req: true
      short: "User's email address"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "User's full name"
      type: "`$STRING`"
    }
    {
      format: "password"
      name: "password"
      req: true
      short: "User's password"
      type: "`$STRING`"
    }
    {
      name: "phone"
      req: false
      short: "User's phone number"
      type: "`$STRING`"
    }
    {
      name: "termsAccepted"
      req: false
      short: "User acceptance of terms and conditions"
      type: "`$BOOLEAN`"
    }
  ]

  name: "register"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /auth/register"
            json: "{\"operationId\":\"registerUser\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"email\":{\"description\":\"User's email address\",\"example\":\"newuser@example.com\",\"format\":\"email\",\"type\":\"string\"},\"name\":{\"description\":\"User's full name\",\"example\":\"John Doe\",\"minLength\":2,\"type\":\"string\"},\"password\":{\"description\":\"User's password\",\"example\":\"SecurePassword123!\",\"format\":\"password\",\"minLength\":6,\"type\":\"string\"},\"phone\":{\"description\":\"User's phone number\",\"example\":\"+905551234567\",\"type\":\"string\"},\"termsAccepted\":{\"description\":\"User acceptance of terms and conditions\",\"example\":true,\"type\":\"boolean\"}},\"required\":[\"email\",\"password\",\"name\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"expiresIn\":{\"description\":\"Token expiration time in seconds\",\"example\":3600,\"type\":\"integer\"},\"refreshToken\":{\"description\":\"Refresh token for obtaining new access tokens\",\"example\":\"rt_8f9a7b6c5d4e3f2a1b0c9d8e7f6a5b4c\",\"type\":\"string\"},\"success\":{\"example\":true,\"type\":\"boolean\"},\"token\":{\"description\":\"JWT authentication token\",\"example\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\"type\":\"string\"},\"user\":{\"properties\":{\"createdAt\":{\"description\":\"Account creation timestamp\",\"example\":\"2023-01-15T10:30:00Z\",\"format\":\"date-time\",\"type\":\"string\"},\"email\":{\"description\":\"User's email address\",\"example\":\"user@example.com\",\"format\":\"email\",\"type\":\"string\"},\"id\":{\"description\":\"Unique user identifier\",\"example\":\"usr_123456789\",\"type\":\"string\"},\"name\":{\"description\":\"User's full name\",\"example\":\"John Doe\",\"type\":\"string\"},\"phone\":{\"description\":\"User's phone number\",\"example\":\"+905551234567\",\"type\":\"string\"},\"subscriptionStatus\":{\"description\":\"User's subscription status\",\"enum\":[\"active\",\"inactive\",\"trial\"],\"example\":\"active\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"User successfully registered\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"example\":\"INVALID_CREDENTIALS\",\"type\":\"string\"},\"details\":{\"items\":{\"properties\":{\"field\":{\"example\":\"email\",\"type\":\"string\"},\"message\":{\"example\":\"Email is required\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"message\":{\"description\":\"Human-readable error message\",\"example\":\"Invalid email or password\",\"type\":\"string\"}},\"type\":\"object\"},\"success\":{\"example\":false,\"type\":\"boolean\"}},\"type\":\"object\"}}},\"description\":\"Bad request - invalid input or validation errors\"},\"409\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"example\":\"INVALID_CREDENTIALS\",\"type\":\"string\"},\"details\":{\"items\":{\"properties\":{\"field\":{\"example\":\"email\",\"type\":\"string\"},\"message\":{\"example\":\"Email is required\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"message\":{\"description\":\"Human-readable error message\",\"example\":\"Invalid email or password\",\"type\":\"string\"}},\"type\":\"object\"},\"success\":{\"example\":false,\"type\":\"boolean\"}},\"type\":\"object\"}}},\"description\":\"User already exists\"}},\"securitySchemes\":{\"bearerAuth\":{\"bearerFormat\":\"JWT\",\"description\":\"JWT token obtained from login or social login endpoints\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/auth/register"
          segments: [
            {
              lit: "auth"
            }
            {
              lit: "register"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
      ]
    }
  }



}
