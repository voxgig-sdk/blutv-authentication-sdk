# Entity: register

main: kit: entity: register: {

  alias: field: {}

  fields: [
    {
      format: "email"
      name: "email"
      req: true
      short: "User's email address"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "User's full name"
      type: "`$STRING`"
    }
    {
      format: "password"
      name: "password"
      req: true
      short: "User's password"
      type: "`$STRING`"
    }
    {
      name: "phone"
      req: false
      short: "User's phone number"
      type: "`$STRING`"
    }
    {
      name: "termsAccepted"
      req: false
      short: "User acceptance of terms and conditions"
      type: "`$BOOLEAN`"
    }
  ]

  name: "register"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/auth/register"
          segments: [
            {
              lit: "auth"
            }
            {
              lit: "register"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
      ]
    }
  }



}
