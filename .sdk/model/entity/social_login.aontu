# Entity: social_login

main: kit: entity: social_login: {

  alias: field: {}

  fields: {
    accessToken: {
      h: "Access Token"
      n: "accessToken"
      r: true
      sh: "OAuth access token from the social provider"
      t: "`$STRING`"
    }
    expiresIn: {
      h: "Expires In"
      n: "expiresIn"
      r: false
      sh: "Token expiration time in seconds"
      t: "`$INTEGER`"
    }
    provider: {
      h: "Provider"
      n: "provider"
      r: true
      sh: "Social media provider"
      t: "`$STRING`"
    }
    refreshToken: {
      h: "Refresh Token"
      n: "refreshToken"
      r: false
      sh: "Refresh token for obtaining new access tokens"
      t: "`$STRING`"
    }
    success: {
      h: "Success"
      n: "success"
      r: false
      t: "`$BOOLEAN`"
    }
    token: {
      h: "Token"
      n: "token"
      r: false
      sh: "JWT authentication token"
      t: "`$STRING`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      t: "`$OBJECT`"
    }
  }

  name: "social_login"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /auth/social-login"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/auth/social-login"
          s: [
            {
              lit: "auth"
            }
            {
              lit: "social-login"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
