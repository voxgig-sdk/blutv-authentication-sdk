# Entity: social_login

main: kit: entity: social_login: {

  alias: field: {}

  fields: [
    {
      name: "accessToken"
      req: true
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: false
      type: "`$STRING`"
    }
    {
      name: "email"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "phone"
      req: false
      type: "`$STRING`"
    }
    {
      name: "provider"
      req: true
      type: "`$STRING`"
    }
    {
      name: "subscriptionStatus"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "social_login"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/auth/social-login"
          parts: [
            "auth"
            "social-login"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
      ]
    }
  }



}
